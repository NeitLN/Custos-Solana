{
  "name": "custos",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0 <25",
    "npm": "11.6.2"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test --experimental-strip-types \"packages/**/test/*.test.ts\" \"apps/**/test/*.test.ts\"",
    "check": "npm run typecheck && npm run test",
    "so-lieu": "node --experimental-strip-types scripts/tao-so-lieu.ts && node scripts/dong-bo-so-tai-lieu.mjs --da-do",
    "hien-truong": "node --experimental-strip-types scripts/dung-hien-truong.ts",
    "vi": "npm run dev -w @custos-solana/demo-wallet",
    "tan-cong": "npm run dev -w @custos-solana/trang-tan-cong",
    "soi-khoa": "node scripts/soi-ro-ri-khoa.mjs site",
    "publish-sdk": "node scripts/dong-goi-sdk.mjs --publish",
    "thu-goi": "node scripts/thu-goi-nguoi-ngoai.mjs",
    "thu-tich-hop": "node scripts/thu-tich-hop.mjs",
    "eval-ai": "node --experimental-strip-types scripts/eval-ai.ts",
    "nguoi-mua": "node --experimental-strip-types scripts/kiem-nguoi-mua.ts"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "axe-core": "4.13.0",
    "pptxgenjs": "4.0.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.98.4"
  },
  "license": "MIT",
  "packageManager": "npm@11.6.2"
}
