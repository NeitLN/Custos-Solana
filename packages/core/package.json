{
  "name": "@custos-solana/core",
  "version": "0.1.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@custos-solana/types": "^0.1.0",
    "@solana/web3.js": "^1",
    "@solana/spl-token": "^0.4"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "access": "public"
  },
  "description": "Phát hiện hậu quả không thuộc về hành động chính của một giao dịch Solana, trước khi người dùng ký. L1 bóc tách + L2 mười bốn luật tất định.",
  "license": "MIT",
  "author": "Team Too Hard",
  "homepage": "https://github.com/NeitLN/Custos-Solana#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NeitLN/Custos-Solana.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/NeitLN/Custos-Solana/issues"
  },
  "keywords": [
    "solana",
    "wallet",
    "security",
    "transaction",
    "simulation",
    "web3",
    "sdk",
    "custos"
  ]
}
