# Sai phiên bản thì DỪNG NGAY, đừng hỏng sâu trong cây phụ thuộc.
#
# Không có dòng này, `engines` chỉ là một lời cảnh báo trôi qua trong log: npm in
# `EBADENGINE` rồi cài tiếp, và thứ vỡ ra sau đó là một lỗi khó hiểu ở tận đâu —
# runner từng lấy Node 24.19 trong khi máy dev là 24.12, và `npm ci` hỏng vì hai
# bản npm dựng cây phụ thuộc khác nhau cho peerOptional native của `ws`.
#
# Đội có 4 người và một hạn cứng. Một dòng lỗi nói thẳng "cần Node 24.12" đáng giá
# hơn nửa buổi tối đi dò.
engine-strict=true
